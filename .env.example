# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public site URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Admin
ADMIN_ALLOWED_EMAILS=admin@example.com

# Standard AI runtime
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_API_KEY=
GROQ_FALLBACK_MODEL=llama3-70b-8192
GROQ_MAX_ATTEMPTS=2

# Optional DeepsProxy runtime
DEEPSPROXY_API_KEY=
DEEPSPROXY_BASE_URL=
DEEPSPROXY_MODEL=deepseek-thinking
DEEPSPROXY_FREE_MODEL=deepseek-no-thinking
DEEPSPROXY_MAX_MODEL=deepseek-thinking
DEEPSPROXY_TIMEOUT_MS=90000
DEEPSPROXY_CONFIG_URL_KEY=deepsproxy_public_url
DEEPSPROXY_CONFIG_MODEL_KEY=deepsproxy_model
DEEPSPROXY_CONFIG_FREE_MODEL_KEY=deepsproxy_free_model
DEEPSPROXY_CONFIG_MAX_MODEL_KEY=deepsproxy_max_model
DEEPSPROXY_ENV_FILE=.env.deepsproxy
LOCAL_DEEPSPROXY_URL=http://127.0.0.1:3001
QUESTIONS_DEEPSPROXY_TIMEOUT_MS=18000

# Max plan AI runtime
NVIDIA_API_KEY=
NVIDIA_MAX_TIMEOUT_MS=8000

# OCR
GEMINI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MAX_PRICE_ID=

# News import
NEWSAPI_API_KEY=
NEWSAPI_KEY=

# Vercel sets VERCEL, VERCEL_URL, and VERCEL_PROJECT_PRODUCTION_URL automatically.
